      "model": {
        "primary": "frontier-llm",
        "fallback": "local-llm",
        "confidential_route": "local-llm"
      },
      "instructions": "Keep the kiln stable and efficient. Warn of jams, explain heat losses and advise raw mix changes.",
      "skills": [
        "cyclone-jam-prediction",
        "raw-mix-control",
        "heat-balance"
      ],
      "tools": [
        "plantdb.uns_browse",
        "plantdb.uns_search",
