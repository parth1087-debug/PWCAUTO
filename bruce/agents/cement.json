        "plantdb.get_production",
        "plantdb.get_oee_losses",
        "plantdb.get_energy",
        "plantdb.get_quality",
        "plantdb.list_messages",
        "plantdb.search_docs",
        "deepsense.forecast"
      ],
      "triggers": [
        {
          "type": "prompt"
        },
        {
          "type": "event",
          "on": "c4_draft rising"
        }
      ],
      "can_call": [],
      "autonomy": "act_with_approval",
      "policies": [
        "P-01",
        "P-02",
        "P-10"
